          # O(log n) 
class Solution {
    public double myPow(double x, int n) {
        if (n == 0) {
            return 1.0;
        }

        long exp = n; // Convert n to long to handle -2147483648
        if (exp < 0) {
            x = 1 / x;
            exp = -exp;
        }

        double res = 1.0;
        while (exp > 0) {
            if (exp % 2 != 0) {
                res *= x;
            }
            x *= x;
            exp /= 2;
        }
        return res;
    }
}
